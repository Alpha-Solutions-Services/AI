# ─── Alpha AI URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_AI_URL=https://ai.alphasolutions.software
NEXT_PUBLIC_SITE_URL=https://www.alphasolutions.software
NEXT_PUBLIC_PORTAL_URL=https://portal.alphasolutions.software
NEXT_PUBLIC_TMS_URL=https://tms.alphasolutions.software
NEXT_PUBLIC_LEARN_DISPATCH_URL=https://learndispatch.alphasolutions.software

# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs:
#   https://ai.alphasolutions.software/auth/callback
#   http://localhost:3004/auth/callback

# ─── Supabase (same project as Portal / TMS / Learn Dispatch) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Staff allowlists ───────────────────────────────────────────────────────
# Who can use Alpha (comma-separated). Falls back to ADMIN_EMAILS + built-ins.
ALPHA_STAFF_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=you@example.com,teammate@example.com
# Owners can audit all conversations
ALPHA_OWNER_EMAILS=you@example.com
OWNER_EMAILS=you@example.com

# ─── Groq ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# ─── Optional embeddings (OpenAI-compatible). If unset, FTS-only retrieval. ─
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ─── Optional GitHub (live org repo list) ───────────────────────────────────
# GITHUB_TOKEN=ghp_xxx

# ─── Optional web search (Tavily). Falls back to DuckDuckGo if unset. ───────
# TAVILY_API_KEY=

# ─── Sanity (read knowledge from CMS) ───────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=

# ─── SMTP (ops draft emails) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_app_password
SMTP_FROM=Alpha <no-reply@alphasolutions.software>
AUTH_OPS_NOTIFY_EMAIL=ops@example.com

# ─── Cron ───────────────────────────────────────────────────────────────────
CRON_SECRET=generate_a_long_random_string
